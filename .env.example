# Bản mẫu cho docker-compose.yml — tạo file `.env` (bị git bỏ qua) cạnh file
# này với giá trị thật, ví dụ:
#   MONGO_ROOT_USER=wchem
#   MONGO_ROOT_PASSWORD=$(openssl rand -base64 24)
#   JWT_SECRET=$(openssl rand -base64 48)
# Chạy: cp .env.example .env  (rồi điền giá trị), sau đó `docker compose up -d --build`.
MONGO_ROOT_USER=wchem
MONGO_ROOT_PASSWORD=change-me-generate-with-openssl
JWT_SECRET=change-me-generate-with-openssl
