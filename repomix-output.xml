@media (max-width: 480px) {
  .kl-hero-title { font-size: 22px; }
  .kl-hero-sub { font-size: 13px; }
  .kl-primary-btn { padding: 12px 24px; font-size: 13px; }

  .kl-console-stats { flex-wrap: wrap; }
}
