        </div>
      </div>
      <div class="lab-console-box">
        <div id="lab-console"></div>
      </div>
    </div>
  </div>
</div>

<div id="lab-toast"></div>
<button id="lab-stopTracking" class="lab-stop-tracking" hidden>
  <span class="material-symbols-outlined">videocam_off</span><span>Tắt camera</span>
</button>

<script>window.HAND_SCOPE_MANUAL_START = true;</script>
