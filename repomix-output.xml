<file path="css/handscope-shell.css">
/* =========================================================
   HAND//SCOPE — Design System & UI (Kinetic Lab theme)
   ========================================================= */

/* ---------- Reset & Base ---------- */
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  background: #f0f2ff;
  font-family: 'Inter', sans-serif;
  color: #0b1c30;
  -webkit-font-smoothing: antialiased;
}

.material-symbols-outlined {
  font-family: 'Material Symbols Outlined';
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-smoothing: antialiased;
}

#kl-root {
  position: fixed;
  inset: 0;
  z-index: 900000;
  font-family: 'Inter', sans-serif;
  color: #0b1c30;
}

/* ---------- Glass morphism utilities ---------- */
.kl-glass {
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
}
.kl-glass-dark {
  background: rgba(16, 40, 77, 0.92);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(127, 149, 255, 0.25);
  color: #dde1ff;
}
.kl-luminous {
  box-shadow: 0px 20px 40px rgba(127, 149, 255, 0.15);
}
.kl-glow-btn {
  transition: all 0.3s ease;
  box-shadow: 0 0 15px rgba(63, 86, 188, 0.4);
  cursor: pointer;
  border: none;
  font-family: 'Space Grotesk', sans-serif;
}
.kl-glow-btn:hover {
  box-shadow: 0 0 25px rgba(63, 86, 188, 0.7);
  transform: translateY(-2px);
}

/* ---------- Landing Page ---------- */
#kl-landing {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #f0f2ff 0%, #e8ecff 50%, #f5f0ff 100%);
}

#kl-particles {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.kl-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  height: 80px;
}
.kl-header-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.kl-header-brand-name {
  font-weight: 700;
  font-size: 22px;
  color: #3f56bc;
  letter-spacing: -0.02em;
}
.kl-header-btn {
  padding: 8px 18px;
  border-radius: 8px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 13px;
  color: #3f56bc;
  cursor: pointer;
  background: rgba(255,255,255,0.55);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.6);
  transition: all 0.2s;
}
.kl-header-btn:hover {
  background: rgba(255,255,255,0.8);
}

.kl-hero {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 0 64px;
  max-width: 760px;
}
.kl-hero-badge {
  padding: 6px 16px;
  border-radius: 999px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05);
}
.kl-hero-badge span:first-child {
  color: #3f56bc;
  font-size: 16px;
}
.kl-hero-badge span:last-child {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 12px;
  color: #3f56bc;
}
.kl-hero-title {
  font-size: 48px;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: #0b1c30;
  margin: 0 0 20px;
}
.kl-hero-title .kl-gradient {
  background: linear-gradient(90deg, #3f56bc, #00aacd);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.kl-hero-sub {
  font-size: 18px;
  line-height: 1.6;
  color: #444653;
  margin: 0 0 36px;
  max-width: 560px;
}
.kl-primary-btn {
  background: linear-gradient(90deg, #3f56bc, #233ca3);
  color: #fff;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
  padding: 16px 32px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  border: none;
  transition: all 0.3s ease;
  box-shadow: 0 0 15px rgba(63, 86, 188, 0.4);
}
.kl-primary-btn:hover {
  box-shadow: 0 0 25px rgba(63, 86, 188, 0.7);
  transform: translateY(-2px);
}

.kl-footer {
  position: relative;
  z-index: 2;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32px;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 11px;
  color: #444653;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255, 255, 255, 0.6);
}
.kl-footer-ver {
  opacity: 0.6;
}

/* ---------- Lab workspace ---------- */
#kl-lab {
  opacity: 0;
  pointer-events: none;
  position: absolute;
  inset: 0;
  transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1), transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
  transform: scale(0.96);
}
#kl-root.kl-active #kl-landing {
  opacity: 0;
  transform: scale(1.06);
  pointer-events: none;
  transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1), transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
}
#kl-root.kl-active #kl-lab {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

/* ---------- Sidebar ---------- */
.kl-lab-sidebar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 220px;
  display: flex;
  flex-direction: column;
  padding: 16px 12px;
  gap: 4px;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(20px);
  border-right: 1px solid rgba(255, 255, 255, 0.6);
}
.kl-lab-sidebar-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 4px 20px;
}
.kl-back-btn {
  background: none;
  border: none;
  cursor: pointer;
  color: #3f56bc;
  padding: 4px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.kl-back-btn:hover {
  background: rgba(63,86,188,0.1);
}
.kl-back-btn .material-symbols-outlined {
  font-size: 20px;
}
.kl-lab-sidebar-header-text {
  font-size: 13px;
  font-weight: 600;
}
.kl-lab-sidebar-header-sub {
  font-size: 10px;
  color: #757684;
  font-family: 'Space Grotesk', sans-serif;
}
.kl-tab {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 8px;
  cursor: pointer;
  color: #444653;
  opacity: 0.75;
  border-left: 4px solid transparent;
  transition: all 0.2s;
  font-family: 'Space Grotesk', sans-serif;
  font-size: 14px;
