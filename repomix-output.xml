import { useState } from 'react';

export type Phase = 'gas' | 'liquid' | 'solid';

const KNOWN_PHASES: Record<string, Phase> = {
  H2O: 'liquid',
  H2O2: 'liquid',
  D2O: 'liquid',
  CO2: 'gas',
  O2: 'gas',
  N2: 'gas',
  H2: 'gas',
  CL2: 'gas',
  F2: 'gas',
  BR2: 'liquid',
  HG: 'liquid',
  C2H5OH: 'liquid',
  CH3OH: 'liquid',
  C6H6: 'liquid',
  H2SO4: 'liquid',
  HNO3: 'liquid',
  HCL: 'gas',
  NH3: 'gas',
  C6H12O6: 'solid',
  C12H22O11: 'solid',
  NACL: 'solid',
  KCL: 'solid',
  CACO3: 'solid',
  SIO2: 'solid',
  FE: 'solid',
  CU: 'solid',
  AU: 'solid',
  AG: 'solid',
  AL: 'solid',
  C: 'solid',
  S: 'solid',
  P: 'solid',
